#
# krender is format/render.py under that name. ExecSearchPath= finds it
# where a developer keeps programs, which the service manager's own search
# path leaves out.

[Unit]
Description=kresults Site Renderer
Documentation=https://github.com/linux-kdevops/kresults/blob/main/docs/deploy.rst
# The path unit starts this for every record, and a burst of them must not
# leave the site behind the tree.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecSearchPath=%h/.local/bin:%h/.nix-profile/bin:/usr/local/bin:/usr/bin
ExecStart=krender --records %S/krecords --output ${CACHE_DIRECTORY}/site
CacheDirectory=kresults
Slice=background.slice
NoNewPrivileges=yes
PrivateUsers=yes
ProtectHome=read-only
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
