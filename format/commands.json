{
  "schema": 1,
  "projects": {
    "linux": {
      "env": {
        "make": ["ARCH", "LLVM", "CROSS_COMPILE", "KCFLAGS", "KBUILD_EXTRA_WARN"]
      },
      "commands": [
        {
          "command": "make TARGET, to configure",
          "argv": "make *config",
          "record": "make/*config.json",
          "under": "build"
        },
        {
          "command": "scripts/kconfig/merge_config.sh",
          "record": "merge_config.sh.json",
          "under": "build"
        },
        {
          "command": "make",
          "argv": "make",
          "record": "make/all.json",
          "under": "build"
        },
        {
          "command": "make dir-pkg",
          "record": "make/dir-pkg.json",
          "under": "build"
        },
        {
          "command": "make checkstack",
          "record": "make/checkstack.json",
          "under": "build"
        },
        {
          "command": "make rusttest",
          "record": "make/rusttest.json",
          "under": "build"
        },
        {
          "command": "make rustdoc",
          "record": "make/rustdoc.json",
          "under": "build"
        },
        {
          "command": "make rustavailable",
          "record": "make/rustavailable.json",
          "under": "commit"
        },
        {
          "command": "make W=1e OBJ, compiled by clang",
          "record": "clang/**.json",
          "under": "build"
        },
        {
          "command": "make W=1e OBJ, compiled by gcc",
          "record": "gcc/**.json",
          "under": "build"
        },
        {
          "command": "make C=2 CF=-Wsparse-error OBJ",
          "record": "sparse/**.json",
          "under": "build"
        },
        {
          "command": "make C=2 CHECK=\"smatch --project=kernel --fatal-checks\" OBJ",
          "record": "smatch/**.json",
          "under": "build"
        },
        {
          "command": "make C=2 CHECK='$(srctree)/scripts/coccicheck' OBJ",
          "record": "coccicheck/**.json",
          "under": "build"
        },
        {
          "command": "make clang-tidy",
          "record": "make/clang-tidy.json",
          "under": "build"
        },
        {
          "command": "make clang-analyzer",
          "record": "make/clang-analyzer.json",
          "under": "build"
        },
        {
          "command": "make CLIPPY=1",
          "record": "make/clippy.json",
          "under": "build"
        },
        {
          "command": "make HEADER_CHECK=FILE headercheck",
          "record": "headercheck/**.json",
          "under": "build"
        },
        {
          "command": "make kconfig-sym-check",
          "record": "make/kconfig-sym-check.json",
          "under": "commit"
        },
        {
          "command": "make refcheckdocs",
          "record": "make/refcheckdocs.json",
          "under": "commit"
        },
        {
          "command": "make testdocs",
          "record": "make/testdocs.json",
          "under": "commit"
        },
        {
          "command": "clang-tidy FILE",
          "record": "clang-tidy/**.json",
          "under": "build"
        },
        {
          "command": "check -s SECTION TEST",
          "record": "fstests/*/**.json",
          "under": "build"
        },
        {
          "command": "check TEST",
          "record": "blktests/*/**.json",
          "under": "build"
        },
        {
          "command": "scripts/checkpatch.pl --git RANGE",
          "record": "checkpatch.pl.json",
          "under": "commit"
        },
        {
          "command": "scripts/get_maintainer.pl PATCH",
          "record": "get_maintainer.pl.json",
          "under": "commit"
        },
        {
          "command": "scripts/kernel-doc FILE",
          "record": "kernel-doc/**.json",
          "under": "commit"
        },
        {
          "command": "scripts/checkincludes.pl FILE",
          "record": "checkincludes.pl/**.json",
          "under": "commit"
        },
        {
          "command": "scripts/checkversion.pl FILE",
          "record": "checkversion.pl/**.json",
          "under": "commit"
        },
        {
          "command": "scripts/headerdep.pl -I include FILE",
          "record": "headerdep.pl/**.json",
          "under": "commit"
        },
        {
          "command": "scripts/check-uapi.sh -b HEAD -p BASE",
          "record": "check-uapi.sh.json",
          "under": "commit"
        },
        {
          "command": "scripts/checkkconfigsymbols.py",
          "record": "checkkconfigsymbols.py.json",
          "under": "commit"
        },
        {
          "command": "make SPHINXDIRS=DIR SPHINXOPTS=--fresh-env htmldocs",
          "record": "make/htmldocs/**.json",
          "under": "commit"
        },
        {
          "command": "make rustfmtcheck",
          "record": "make/rustfmtcheck.json",
          "under": "commit"
        },
        {
          "command": "b4 mbox",
          "record": "b4/mbox.json",
          "under": "series"
        },
        {
          "command": "b4 shazam",
          "record": "b4/shazam.json",
          "under": "series"
        }
      ]
    },
    "qemu": {
      "env": {
        "configure": ["CC", "CXX", "CFLAGS", "CXXFLAGS", "LDFLAGS"]
      },
      "commands": [
        {
          "command": "scripts/checkpatch.pl --branch RANGE",
          "record": "checkpatch.pl.json",
          "under": "commit"
        },
        {
          "command": "configure --target-list=LIST",
          "argv": "configure --target-list=*",
          "record": "configure.json",
          "under": "commit"
        },
        {
          "command": "make",
          "argv": "make",
          "record": "make/all.json",
          "under": "commit"
        }
      ]
    }
  }
}
